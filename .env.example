# URL pública de la aplicación (sin barra final). Usada para construir la
# URL de callback OAuth de Shopify que el comerciante registra en su app.
NEXT_PUBLIC_APP_URL="https://tu-dominio.es"

# Database
DATABASE_URL="postgresql://user:password@host:5432/geo_web"

# NextAuth
NEXTAUTH_SECRET="<genera con: openssl rand -base64 32>"
NEXTAUTH_URL="https://tu-dominio.es"

# n8n integration
N8N_WEBHOOK_URL=""
N8N_CALLBACK_SECRET="<genera con: openssl rand -base64 32>"

# Schema.org generator + crawl multipágina (FastAPI)
SCHEMA_API_BASE="https://api.tu-dominio.es"

# Shopify — cifrado de secretos y access tokens
# 32 bytes hex (64 chars). Genera con: openssl rand -hex 32
# CRÍTICO: si se pierde esta clave, los secretos/tokens guardados son
# irrecuperables y los comerciantes deben reconectar. Backup en gestor de
# contraseñas, NUNCA en el repo.
SHOPIFY_TOKEN_KEY="<genera con: openssl rand -hex 32>"

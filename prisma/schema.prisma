generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  mcpToken            String?              @unique
  jobs                Job[]
  shopifyConnections  ShopifyConnection[]
}

enum JobStatus {
  pending
  running
  succeeded
  failed
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeDomain   String
  status        JobStatus @default(pending)
  summary       String?   @db.Text
  errorMessage  String?   @db.Text
  failureReason String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([userId, startedAt])
}

model ShopifyConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopDomain      String
  clientId        String
  clientSecretEnc String    @db.Text
  accessTokenEnc  String?   @db.Text
  scopes          String
  status          String
  installedAt     DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@unique([userId, shopDomain])
  @@index([shopDomain])
}

model CompetitorSet {
  id           String   @id @default(cuid())
  userId       String
  url          String
  competitors  String[]
  updatedAt    DateTime @updatedAt

  @@unique([userId, url])
  @@index([userId])
}

model SiteAudit {
  id           String   @id @default(cuid())
  userId       String
  url          String
  domain       String
  score        Int
  pagesAudited Int
  result       Json
  createdAt    DateTime @default(now())

  @@index([userId, domain, createdAt])
}

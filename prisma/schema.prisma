generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                  String               @id @default(cuid())
  email               String               @unique
  passwordHash        String
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  mcpToken            String?              @unique
  jobs                Job[]
  shopifyConnections  ShopifyConnection[]
}

enum JobStatus {
  pending
  running
  succeeded
  failed
}

model Job {
  id            String    @id @default(cuid())
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  storeDomain   String
  status        JobStatus @default(pending)
  summary       String?   @db.Text
  errorMessage  String?   @db.Text
  failureReason String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?

  @@index([userId, startedAt])
}

model ShopifyConnection {
  id              String    @id @default(cuid())
  userId          String
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  shopDomain      String
  clientId        String
  clientSecretEnc String    @db.Text
  accessTokenEnc  String?   @db.Text
  scopes          String
  status          String
  installedAt     DateTime?
  createdAt       DateTime  @default(now())
  revokedAt       DateTime?

  @@unique([userId, shopDomain])
  @@index([shopDomain])
}

model CompetitorSet {
  id           String   @id @default(cuid())
  userId       String
  companyId    String?
  url          String
  competitors  String[]
  updatedAt    DateTime @updatedAt

  @@unique([userId, url])
  @@index([userId])
  @@index([companyId])
}

model SiteAudit {
  id           String   @id @default(cuid())
  userId       String
  companyId    String?
  url          String
  domain       String
  score        Int
  pagesAudited Int
  result       Json
  createdAt    DateTime @default(now())

  @@index([userId, domain, createdAt])
  @@index([companyId, createdAt])
}

// Ficha de cliente: agrupa el trabajo (auditorias, competidores, actividad) de una
// empresa concreta, para quien gestiona varias.
model Company {
  id        String   @id @default(cuid())
  userId    String
  name      String
  website   String?
  sector    String?
  notes     String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId])
}

// Firmas Web Bot Auth por dominio: las tres cabeceras que el comerciante genera en su
// admin de Shopify (Online Store > Preferences > Crawler access). Son credenciales
// portadoras (quien las tiene rastrea como nosotros), así que se guardan cifradas con
// AES-256-GCM y no se devuelven nunca al navegador. Caducan a los 3 meses y no se
// renuevan: por eso expiresAt es obligatorio y la interfaz avisa antes de tiempo.
model CrawlSignature {
  id             String   @id @default(cuid())
  userId         String
  companyId      String?
  origin         String
  signatureInput String   @db.Text
  signature      String   @db.Text
  signatureAgent String   @db.Text
  expiresAt      DateTime
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@unique([userId, origin])
  @@index([companyId])
}

// Diario de actividad: que se ejecuto, sobre que y con que resultado. Alimenta el
// historial y la ficha de cada empresa.
model ActivityLog {
  id        String   @id @default(cuid())
  userId    String
  companyId String?
  kind      String
  target    String
  score     Int?
  detail    Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([companyId, createdAt])
}
